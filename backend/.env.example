# OpenClaw Gateway: do not paste secrets into source control.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Use an OpenClaw agent model alias, not the upstream Groq model ID.
OPENCLAW_MODEL=openclaw/main

# Hindsight Cloud: persistent memory for OpenClaw and analytics.
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_TOKEN=
HINDSIGHT_BANK_ID=influx-ai-creator

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
